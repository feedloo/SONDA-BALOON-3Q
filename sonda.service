[Unit]
Description=Sonda 3Q IW3BAU - sensori, archivio SD e trasmissione SSTV 433.4 MHz
# Parte presto all'accensione SENZA aspettare la rete né un login:
# in volo non c'è rete, e se il servizio fosse ordinato dopo
# multi-user.target resterebbe fermo finché qualcuno non si collega
# (l'avvio aspetta la rete / cloud-init prima di raggiungere quel target).
After=local-fs.target sysinit.target
# niente limite di riavvii: in volo deve ripartire sempre
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=@DIR@
# Attesa dopo l'accensione prima di partire (secondi): lascia stabilizzare
# alimentazione, camera e RS41. Cambiate il numero se volete più/meno attesa.
ExecStartPre=/bin/sleep 20
ExecStart=@DIR@/venv/bin/python @DIR@/sonda/main.py
Restart=always
RestartSec=10
Nice=-5
Environment=PYTHONUNBUFFERED=1
# allo stop: 20 s per chiudere bene (finisce di scrivere i file), poi in
# ogni caso il pin RF viene rimesso a riposo (nessun segnale verso l'ampli)
TimeoutStopSec=20
ExecStopPost=-/bin/sh -c 'pinctrl set 20 ip 2>/dev/null || raspi-gpio set 20 ip 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
